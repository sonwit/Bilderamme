# Kopier denne til /opt/fugleramme/frame_server.env paa hjemmeserveren og fyll inn.
# systemd-tjenesten (fugleramme-frame-server.service) leser den ved oppstart.

# Kreves — samme Gemini-noekkel som generate_daily_image.py bruker:
GEMINI_API_KEY=din-gemini-noekkel-her

# Rammens adresse. IP er tryggest fra en Linux-server (mDNS/.local slaar ofte
# ikke opp uten avahi). Gi rammen en fast IP via DHCP-reservasjon paa ruteren
# saa denne aldri endrer seg.
FRAME_HOST=192.168.1.94

# Valgfritt:
# FRAME_SERVER_PORT=8090
# FRAME_TOKEN=en-hemmelig-streng   # settes den, maa kall ha ?token=... eller header X-Token
