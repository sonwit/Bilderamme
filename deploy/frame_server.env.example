# Kopier denne til /opt/fugleramme/frame_server.env paa hjemmeserveren og fyll inn.
# systemd-tjenesten (fugleramme-frame-server.service) leser den ved oppstart.

# Kreves — samme Gemini-noekkel som generate_daily_image.py bruker:
GEMINI_API_KEY=din-gemini-noekkel-her

# Rammens adresse. Bruk navnet, ikke IP: brettet henter adresse fra DHCP, og
# da den byttet fra .94 til .92 stoppet dagens bilde i aatte doegn (19.-26. aug)
# uten at noe annet feilet. Serveren har libnss-mdns fra 26. aug, saa navnet
# loeser seg her. Ryker avahi: sett en IP her til det er oppe igjen.
# (Trenger du likevel aa gaa utenom navneoppslaget: sett en IP her.)
FRAME_HOST=fugleramme.local

# Valgfritt:
# FRAME_SERVER_PORT=8090
# FRAME_TOKEN=en-hemmelig-streng   # settes den, maa kall ha ?token=... eller header X-Token

# Hvor hagen er (tools/oppsett.py). Styrer vaervarselet fra api.met.no,
# BirdNETs artsfilter og soloppgangen i lytteplanen. To desimaler holder --
# det er rundt en kilometer, og ingen av de tre skiller finere.
# FUGLERAMME_LAT=59.98
# FUGLERAMME_LON=10.93
# Stedsnavnet paa fuglesida, over vaeret. Bare et navn; bunnlinja viser koordinatene.
# FUGLERAMME_STED=Hagen

# Kontakten i User-Agent mot api.met.no og Wikimedia Commons, som begge krever
# at klienten sier hvem den er. E-post eller URL. Standard peker til repoet.
# FUGLERAMME_KONTAKT=https://github.com/sonwit/Bilderamme
