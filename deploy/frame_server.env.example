# Kopier denne til /opt/fugleramme/frame_server.env paa hjemmeserveren og fyll inn.
# systemd-tjenesten (fugleramme-frame-server.service) leser den ved oppstart.

# Kreves — samme Gemini-noekkel som generate_daily_image.py bruker:
GEMINI_API_KEY=din-gemini-noekkel-her

# Rammens adresse. Bruk navnet, ikke IP: brettet henter adresse fra DHCP, og
# da den byttet fra .94 til .92 stoppet dagens bilde i aatte doegn (19.-26. aug)
# uten at noe annet feilet. Serveren har libnss-mdns fra 26. aug, og
# push_to_frame.py slaar i tillegg opp .local over mDNS selv som reserve.
# (Trenger du likevel aa gaa utenom navneoppslaget: sett en IP her.)
FRAME_HOST=fugleramme.local

# Valgfritt:
# FRAME_SERVER_PORT=8090
# FRAME_TOKEN=en-hemmelig-streng   # settes den, maa kall ha ?token=... eller header X-Token
